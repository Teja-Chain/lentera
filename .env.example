# ==============================================================================
# LENTERA ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# 1. Primary AI Engine: Google Gemini Flash
# Comma-separated API keys for seamless round-robin rotation and 429 auto-failover
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_1
GEMINI_MODEL=gemini-flash-latest

# 2. Secondary AI Fallback: Groq
# High-speed secondary fallback model with conservative token budgeting
GROQ_API_KEYS=your_groq_api_key_1,your_groq_api_key_2
GROQ_API_KEY=your_groq_api_key_1
GROQ_MODEL=qwen/qwen3.8-27b

# 3. Sibyl Labs SDK (Licensing & Telemetry Authentication)
# Sibyl Labs session token (Tier: stake)
SIBYL_API_KEY=your_sibyl_api_key
SIBYL_ENDPOINT=https://api.sibyllabs.org

# 4. Upstash Cloud KV (Serverless-Safe Cross-Session Persistent Memory)
# Get your free serverless database at https://console.upstash.com or Vercel Marketplace
KV_REST_API_URL=https://your-upstash-db.upstash.io
KV_REST_API_TOKEN=your_upstash_rest_token
UPSTASH_REDIS_REST_URL=https://your-upstash-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# 5. Web3 & Base Sepolia Configuration
# WalletConnect Cloud Project ID (https://cloud.reown.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Optional Relayer private key for server-side executed DEX transactions on Base Sepolia
RELAYER_PRIVATE_KEY=your_funded_base_sepolia_private_key
